# Copy to .env and fill in. Never commit .env.
APP_ENV=development
CORS_ORIGINS=http://localhost:5173

# Supabase (project URL, e.g. https://<ref>.supabase.co)
SUPABASE_URL=
SUPABASE_JWT_AUDIENCE=authenticated
# Only needed if the project still uses the legacy HS256 JWT secret
SUPABASE_JWT_SECRET=

# Restricted app role (nexora_app) via the Supabase session pooler
DATABASE_URL=
# Owner-level URL used only by Alembic migrations
MIGRATION_DATABASE_URL=

# AI provider (optional; leave GEMINI_API_KEY empty for deterministic fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Resume upload and parsing (contract §5, §16)
RESUME_MAX_BYTES=5242880
RESUME_PARSE_MAX_CONCURRENCY=2
RATE_LIMIT_RESUME_PARSES_PER_HOUR=10

# Task runner (contract §2, §16)
TASK_TIMEOUT_RESUME_PARSE_SECONDS=60
TASK_WATCHDOG_INTERVAL_SECONDS=60
TASK_WATCHDOG_GRACE_SECONDS=30
